# ============================================================================
#  Portfolio chat — environment variables
# ----------------------------------------------------------------------------
#  Copy this file to `.env` for local dev (or paste values into your hosting
#  provider's dashboard; .env is NOT committed).
#  Repo variables we actually READ in server/src/config.js.
# ============================================================================

# --- HTTP -------------------------------------------------------------------
PORT=8787
ALLOWED_ORIGIN=https://pranavverma.pages.dev
NODE_ENV=production

# --- Oracle ADB 23ai ---------------------------------------------------------
# Connect descriptor (TCPS over SSL):
DB_USER=ADMIN
DB_PASSWORD=
# Wallet location: a folder containing cwallet.sso, ewallet.p12, tnsnames.ora
# For ADB you download this from the OCI console; the absolute server-side
# path goes below.
DB_WALLET_DIR=
DB_WALLET_PASSWORD=
# TNS alias from tnsnames.ora inside the wallet (e.g. ouraniexcore_low)
DB_TNS_NAME=
# Optional explicit connect string — if present, DB_TNS_NAME is ignored.
# Example shape only — pull your real value from the OCI console / tnsnames.ora.
DB_CONNECT_STRING=(description= (retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=adb.<region>.oraclecloud.com))(connect_data=(service_name=<your_db>_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))

# --- Ouraniex SDK gateway ----------------------------------------------------
# All LLM calls go through the Ouraniex SDK gateway (project CLAUDE.md rule).
OURANIEX_GATEWAY_URL=
OURANIEX_API_KEY=
# Model aliases as registered in the gateway (not direct provider names)
CHAT_MODEL_ALIAS=ouraniex-chat-small
EMBED_MODEL_ALIAS=ouraniex-embed-384

# --- Behaviour --------------------------------------------------------------
CHAT_MAX_QUESTIONS=5
CHAT_MAX_TOKENS=400
CHAT_RETRIEVAL_K=6
CHAT_REFUSAL_HINT=Try asking about his projects, skills, experience, certifications, education, or hobbies.

# --- Trust proxies ----------------------------------------------------------
# If you front this service with Render's load balancer, leave as 1.
TRUST_PROXY=1
